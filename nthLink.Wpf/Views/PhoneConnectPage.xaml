<UserControl x:Class="nthLink.Wpf.Views.PhoneConnectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:attachProperties="clr-namespace:nthLink.Wpf.AttachedProperties"
             xmlns:markupExtension="clr-namespace:nthLink.Wpf.MarkupExtension"
             xmlns:viewModels="clr-namespace:nthLink.Wpf.ViewModels"
             attachProperties:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModels:PhoneConnectPageViewModel}">
    <UserControl.Resources>
        <Style x:Key="PateDefaultTextBlcok" TargetType="TextBlock" 
               BasedOn="{StaticResource DefaultTextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Foreground" Value="{StaticResource AppWhite}"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid VerticalAlignment="Top" Margin="0,64,0,0">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Top">
                <Image x:Name="PART_Image" Width="240" Height="240"
   Source="{Binding ListenAddress, Mode=OneWay, Converter={StaticResource StringToQRCodeImageConverter}}"/>
            </Grid>
        </Grid>

        <TextBlock Style="{StaticResource PateDefaultTextBlcok}"
                   Margin="0,320,0,0"
                   FontSize="14"
                   Text="Scan the QR Code with Leaf VPN on your phone."/>
        <TextBlock Style="{StaticResource PateDefaultTextBlcok}"
                   Margin="0,340,0,0"
                   Text="Your phone must connect to the same local/WiFi network."/>
        <TextBlock Style="{StaticResource PateDefaultTextBlcok}"
                   Margin="0,360,0,0"
                   Text="Your firewall should be properly configured or be disabled."/>
        <TextBlock Style="{StaticResource PateDefaultTextBlcok}"
                   Margin="0,380,0,0"
                   Text="Download Leaf VPN for Android or iOS."/>
    </Grid>
</UserControl>
